<p><a class="btn-link" href="/almacen/expediciones">&larr; Volver al listado</a></p>
<h2>Expedicion <%= idPedido %></h2>

<% if (error) { %>
  <div class="error"><%= error %></div>
<% } %>

<% if (cabecera) { %>
  <div class="card">
    <h3>Cabecera</h3>
    <table>
      <tbody>
        <% Object.keys(cabecera).forEach(function(key) { %>
          <tr><th><%= key %></th><td><%= cabecera[key] %></td></tr>
        <% }); %>
      </tbody>
    </table>
  </div>
<% } %>

<% if (resumenListado) { %>
  <div class="card">
    <h3>Datos del listado (p_expedicionesAza)</h3>
    <table>
      <tbody>
        <% Object.keys(resumenListado).forEach(function(key) { %>
          <tr><th><%= key %></th><td><%= resumenListado[key] %></td></tr>
        <% }); %>
      </tbody>
    </table>
  </div>
<% } %>

<% if (typeof datosRuta === 'undefined' || !datosRuta) { %>
  <div class="card">
    <h3>Datos de la ruta (conductor)</h3>
    <p>Sin ruta asignada, o LUX no devolvio datos de la ruta.</p>
  </div>
<% } else { %>
  <div class="card">
    <h3>Datos de la ruta (conductor)</h3>
    <table>
      <tbody>
        <% Object.keys(datosRuta).filter(function(k) { return k.indexOf('action#') !== 0; }).forEach(function(key) { %>
          <tr><th><%= key %></th><td><%= datosRuta[key] %></td></tr>
        <% }); %>
      </tbody>
    </table>
  </div>
<% } %>

<% if (datosExtra && Object.keys(datosExtra).length > 0) { %>
  <div class="card">
    <h3>Datos extra</h3>
    <table>
      <tbody>
        <% Object.keys(datosExtra).forEach(function(key) { %>
          <tr><th><%= key %></th><td><%= datosExtra[key] %></td></tr>
        <% }); %>
      </tbody>
    </table>
  </div>
<% } %>

<%
  // Columnas = union de las claves de TODAS las filas (una fila sin un campo no oculta la columna).
  // Los flags internos de botones de la UI de Whales (action#...) no son datos y se excluyen.
  function columnasDe(filas) {
    var cols = [];
    filas.forEach(function(f) { Object.keys(f).forEach(function(k) { if (k.indexOf('action#') !== 0 && cols.indexOf(k) === -1) { cols.push(k); } }); });
    return cols;
  }
  var lineaColumnas = columnasDe(lineas);
  var contenedorColumnas = columnasDe(contenedores);
  var decaFilas = (typeof decaRuta !== 'undefined' && decaRuta) ? decaRuta.deca : [];
  var envioFilas = (typeof decaRuta !== 'undefined' && decaRuta) ? decaRuta.envios : [];
  var decaColumnas = columnasDe(decaFilas);
  var envioColumnas = columnasDe(envioFilas);
%>
<div class="card">
  <h3>Lineas (<%= lineas.length %>)</h3>
  <div style="overflow-x:auto;">
  <table>
    <thead>
      <tr>
        <% lineaColumnas.forEach(function(key) { %>
          <th><%= key %></th>
        <% }); %>
      </tr>
    </thead>
    <tbody>
      <% if (lineas.length === 0) { %>
        <tr><td>Sin lineas.</td></tr>
      <% } %>
      <% lineas.forEach(function(linea) { %>
        <tr>
          <% lineaColumnas.forEach(function(key) { %>
            <td><%= linea[key] %></td>
          <% }); %>
        </tr>
      <% }); %>
    </tbody>
  </table>
  </div>
</div>

<div class="card">
  <h3>Contenedores (<%= contenedores.length %>)</h3>
  <div style="overflow-x:auto;">
  <table>
    <thead>
      <tr>
        <% contenedorColumnas.forEach(function(key) { %>
          <th><%= key %></th>
        <% }); %>
      </tr>
    </thead>
    <tbody>
      <% if (contenedores.length === 0) { %>
        <tr><td>Sin contenedores.</td></tr>
      <% } %>
      <% contenedores.forEach(function(c) { %>
        <tr>
          <% contenedorColumnas.forEach(function(key) { %>
            <td><%= c[key] %></td>
          <% }); %>
        </tr>
      <% }); %>
    </tbody>
  </table>
  </div>
</div>

<div class="card">
  <h3>DECA de la ruta (p_expRutasDeca) (<%= decaFilas.length %>)</h3>
  <div style="overflow-x:auto;">
  <table>
    <thead>
      <tr>
        <% decaColumnas.forEach(function(key) { %>
          <th><%= key %></th>
        <% }); %>
      </tr>
    </thead>
    <tbody>
      <% if (decaFilas.length === 0) { %>
        <tr><td>Sin DECA para la ruta.</td></tr>
      <% } %>
      <% decaFilas.forEach(function(d) { %>
        <tr>
          <% decaColumnas.forEach(function(key) { %>
            <td><%= d[key] %></td>
          <% }); %>
        </tr>
      <% }); %>
    </tbody>
  </table>
  </div>
</div>

<div class="card">
  <h3>Envios del DECA (SELECT_ENVIOS) (<%= envioFilas.length %>)</h3>
  <div style="overflow-x:auto;">
  <table>
    <thead>
      <tr>
        <% envioColumnas.forEach(function(key) { %>
          <th><%= key %></th>
        <% }); %>
      </tr>
    </thead>
    <tbody>
      <% if (envioFilas.length === 0) { %>
        <tr><td>Sin envios.</td></tr>
      <% } %>
      <% envioFilas.forEach(function(e) { %>
        <tr>
          <% envioColumnas.forEach(function(key) { %>
            <td><%= e[key] %></td>
          <% }); %>
        </tr>
      <% }); %>
    </tbody>
  </table>
  </div>
</div>
