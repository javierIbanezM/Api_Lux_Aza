<p><a class="btn-link" href="/almacen/expediciones">&larr; Volver al listado</a></p>
<h2>Expedicion <%= idPedido %></h2>

<% if (error) { %>
  <div class="error"><%= error %></div>
<% } %>

<% if (cabecera) { %>
  <div class="card">
    <h3>Cabecera</h3>
    <table>
      <tbody>
        <% Object.keys(cabecera).forEach(function(key) { %>
          <tr><th><%= key %></th><td><%= cabecera[key] %></td></tr>
        <% }); %>
      </tbody>
    </table>
  </div>
<% } %>

<% if (datosExtra && Object.keys(datosExtra).length > 0) { %>
  <div class="card">
    <h3>Datos extra</h3>
    <table>
      <tbody>
        <% Object.keys(datosExtra).forEach(function(key) { %>
          <tr><th><%= key %></th><td><%= datosExtra[key] %></td></tr>
        <% }); %>
      </tbody>
    </table>
  </div>
<% } %>

<div class="card">
  <h3>Lineas</h3>
  <table>
    <thead>
      <tr>
        <th>Id</th>
        <th>Referencia</th>
        <th>Cantidad pedida</th>
        <th>Lote</th>
        <th>Observaciones</th>
      </tr>
    </thead>
    <tbody>
      <% if (lineas.length === 0) { %>
        <tr><td colspan="5">Sin lineas.</td></tr>
      <% } %>
      <% lineas.forEach(function(linea) { %>
        <tr>
          <td><%= linea.id %></td>
          <td><%= linea.referencia %></td>
          <td><%= linea.cantidadPedida %></td>
          <td><%= linea.lote %></td>
          <td><%= linea.observaciones %></td>
        </tr>
      <% }); %>
    </tbody>
  </table>
</div>

<div class="card">
  <h3>Contenedores</h3>
  <table>
    <thead>
      <tr>
        <th>Contenedor</th>
        <th>HU</th>
        <th>Referencia</th>
        <th>Cantidad</th>
        <th>Lote</th>
        <th>Ubicacion</th>
      </tr>
    </thead>
    <tbody>
      <% if (contenedores.length === 0) { %>
        <tr><td colspan="6">Sin contenedores.</td></tr>
      <% } %>
      <% contenedores.forEach(function(c) { %>
        <tr>
          <td><%= c.contenedor %></td>
          <td><%= c.hu %></td>
          <td><%= c.referencia %></td>
          <td><%= c.cantidad %></td>
          <td><%= c.lote %></td>
          <td><%= c.ubicacion %></td>
        </tr>
      <% }); %>
    </tbody>
  </table>
</div>
