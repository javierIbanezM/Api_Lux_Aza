<p><a class="btn-link" href="/almacen/recepciones">&larr; Volver al listado</a></p>
<h2>Recepcion <%= idAlbaran %></h2>

<% if (error) { %>
  <div class="error"><%= error %></div>
<% } %>

<% if (cabecera) { %>
  <div class="card">
    <h3>Cabecera</h3>
    <table>
      <tbody>
        <% Object.keys(cabecera).forEach(function(key) { %>
          <tr><th><%= key %></th><td><%= cabecera[key] %></td></tr>
        <% }); %>
      </tbody>
    </table>
  </div>
<% } %>

<% if (datosExtra && Object.keys(datosExtra).length > 0) { %>
  <div class="card">
    <h3>Datos extra</h3>
    <table>
      <tbody>
        <% Object.keys(datosExtra).forEach(function(key) { %>
          <tr><th><%= key %></th><td><%= datosExtra[key] %></td></tr>
        <% }); %>
      </tbody>
    </table>
  </div>
<% } %>

<div class="card">
  <h3>Lineas</h3>
  <table>
    <thead>
      <tr>
        <th>Id</th>
        <th>Referencia</th>
        <th>Piezas albaran</th>
        <th>Lote</th>
        <th>Observaciones</th>
      </tr>
    </thead>
    <tbody>
      <% if (lineas.length === 0) { %>
        <tr><td colspan="5">Sin lineas.</td></tr>
      <% } %>
      <% lineas.forEach(function(linea) { %>
        <tr>
          <td><%= linea.id %></td>
          <td><%= linea.referencia %></td>
          <td><%= linea.piezasAlbaran %></td>
          <td><%= linea.lote %></td>
          <td><%= linea.observaciones %></td>
        </tr>
      <% }); %>
    </tbody>
  </table>
</div>
