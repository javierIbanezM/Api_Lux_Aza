<p><a class="btn-link" href="/almacen/recepciones">&larr; Volver al listado</a></p>
<h2>Recepcion <%= idAlbaran %></h2>

<% if (error) { %>
  <div class="error"><%= error %></div>
<% } %>

<% if (cabecera) { %>
  <div class="card">
    <h3>Cabecera</h3>
    <table>
      <tbody>
        <% Object.keys(cabecera).forEach(function(key) { %>
          <tr><th><%= key %></th><td><%= cabecera[key] %></td></tr>
        <% }); %>
      </tbody>
    </table>
  </div>
<% } %>

<% if (resumenListado) { %>
  <div class="card">
    <h3>Datos del listado (p_recepcionesAza)</h3>
    <table>
      <tbody>
        <% Object.keys(resumenListado).forEach(function(key) { %>
          <tr><th><%= key %></th><td><%= resumenListado[key] %></td></tr>
        <% }); %>
      </tbody>
    </table>
  </div>
<% } %>

<% if (datosExtra && Object.keys(datosExtra).length > 0) { %>
  <div class="card">
    <h3>Datos extra</h3>
    <table>
      <tbody>
        <% Object.keys(datosExtra).forEach(function(key) { %>
          <tr><th><%= key %></th><td><%= datosExtra[key] %></td></tr>
        <% }); %>
      </tbody>
    </table>
  </div>
<% } %>

<% if (descargas && descargas.length > 0) { %>
  <div class="card">
    <h3>Zonas de descarga disponibles (propietario <%= cabecera.propietario %>)</h3>
    <table>
      <thead>
        <tr>
          <% Object.keys(descargas[0]).forEach(function(key) { %>
            <th><%= key %></th>
          <% }); %>
        </tr>
      </thead>
      <tbody>
        <% descargas.forEach(function(d) { %>
          <tr>
            <% Object.keys(d).forEach(function(key) { %>
              <td><%= d[key] %></td>
            <% }); %>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
<% } %>

<%
  // Columnas = union de las claves de TODAS las filas (una fila sin un campo no oculta la columna).
  // Los flags internos de botones de la UI de Whales (action#...) no son datos y se excluyen.
  function columnasDe(filas) {
    var cols = [];
    filas.forEach(function(f) { Object.keys(f).forEach(function(k) { if (k.indexOf('action#') !== 0 && cols.indexOf(k) === -1) { cols.push(k); } }); });
    return cols;
  }
  var lineaColumnas = columnasDe(lineas);
%>
<div class="card">
  <h3>Lineas (<%= lineas.length %>)</h3>
  <div style="overflow-x:auto;">
  <table>
    <thead>
      <tr>
        <% lineaColumnas.forEach(function(key) { %>
          <th><%= key %></th>
        <% }); %>
      </tr>
    </thead>
    <tbody>
      <% if (lineas.length === 0) { %>
        <tr><td>Sin lineas.</td></tr>
      <% } %>
      <% lineas.forEach(function(linea) { %>
        <tr>
          <% lineaColumnas.forEach(function(key) { %>
            <td><%= linea[key] %></td>
          <% }); %>
        </tr>
      <% }); %>
    </tbody>
  </table>
  </div>
</div>

<%
  // HUs/pallets fisicos recepcionados (p_recAlbaranHUPreinformado). Se muestran TODOS los campos.
  var huColumnas = columnasDe(hus);
%>
<div class="card">
  <h3>HUs recepcionadas (<%= hus.length %>)</h3>
  <div style="overflow-x:auto;">
  <table>
    <thead>
      <tr>
        <% huColumnas.forEach(function(key) { %>
          <th><%= key %></th>
        <% }); %>
      </tr>
    </thead>
    <tbody>
      <% if (hus.length === 0) { %>
        <tr><td>Sin HUs.</td></tr>
      <% } %>
      <% hus.forEach(function(hu) { %>
        <tr>
          <% huColumnas.forEach(function(key) { %>
            <td><%= hu[key] %></td>
          <% }); %>
        </tr>
      <% }); %>
    </tbody>
  </table>
  </div>
</div>
