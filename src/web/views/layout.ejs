<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> · AZA Almacen</title>
  <style>
    body { font-family: Arial, Helvetica, sans-serif; margin: 0; background: #f4f4f4; color: #222; }
    header { background: #1f3a5f; color: #fff; padding: 12px 20px; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; }
    header h1 { margin: 0; font-size: 1.2rem; }
    header nav { display: flex; align-items: center; gap: 14px; }
    header nav a { color: #fff; text-decoration: none; }
    header nav a:hover { text-decoration: underline; }
    header nav form { margin: 0; }
    header nav button { background: #d9534f; color: #fff; border: none; padding: 6px 12px; border-radius: 4px; cursor: pointer; }
    header nav button:hover { background: #c9302c; }
    main { padding: 20px; max-width: 1100px; margin: 0 auto; }
    table { border-collapse: collapse; width: 100%; background: #fff; margin-top: 10px; }
    table th, table td { border: 1px solid #ccc; padding: 6px 10px; text-align: left; font-size: 0.9rem; }
    table th { background: #e9edf2; }
    tr:hover td { background: #f0f6ff; }
    form.filters { background: #fff; padding: 12px; border: 1px solid #ddd; border-radius: 4px; display: flex; gap: 10px; flex-wrap: wrap; align-items: end; }
    form.filters label { display: flex; flex-direction: column; font-size: 0.85rem; gap: 4px; }
    input, select { padding: 6px; border: 1px solid #bbb; border-radius: 4px; }
    button, input[type="submit"] { padding: 7px 14px; border-radius: 4px; border: 1px solid #1f3a5f; background: #1f3a5f; color: #fff; cursor: pointer; }
    button:hover, input[type="submit"]:hover { background: #16283f; }
    .error { background: #fdecea; border: 1px solid #f5c6cb; color: #611a15; padding: 10px; border-radius: 4px; margin-bottom: 14px; }
    .card { background: #fff; border: 1px solid #ddd; border-radius: 4px; padding: 14px; margin-bottom: 16px; }
    a.btn-link { color: #1f3a5f; text-decoration: none; font-weight: bold; }
    a.btn-link:hover { text-decoration: underline; }
    table th a.sort-link { color: #1f3a5f; text-decoration: none; display: inline-block; white-space: nowrap; }
    table th a.sort-link:hover { text-decoration: underline; }
    .login-box { max-width: 360px; margin: 60px auto; }
  </style>
</head>
<body>
  <header>
    <h1>AZA Almacen</h1>
    <% if (typeof username !== 'undefined' && username) { %>
      <nav>
        <a href="/almacen/expediciones">Expediciones</a>
        <a href="/almacen/recepciones">Recepciones</a>
        <form method="POST" action="/almacen/set-almacen" style="margin:0;">
          <label style="color:#fff; display:flex; align-items:center; gap:6px; font-size:0.85rem;">
            Almacen
            <select name="almacen" onchange="this.form.submit()">
              <% warehouses.forEach(function(w) { %>
                <option value="<%= w %>" <%= w === almacen ? 'selected' : '' %>><%= w %></option>
              <% }); %>
            </select>
          </label>
        </form>
        <span>Usuario: <strong><%= username %></strong></span>
        <form method="POST" action="/almacen/logout">
          <button type="submit">Cerrar sesion</button>
        </form>
      </nav>
    <% } %>
  </header>
  <main>
    <%- body %>
  </main>
</body>
</html>
