# Copiar a .env y rellenar con valores reales (NUNCA commitear .env)

# --- LUX API ---
# URL base de la API LUX (Whales), sin barra final. Ej: https://lux.whales-provider.example
LUX_BASE_URL=

# Credenciales del usuario tecnico de la API LUX (rol "web")
LUX_USERNAME=
LUX_PASSWORD=

# Codigo de almacen POR DEFECTO a enviar en la cabecera HTTP "Almacen" en cada llamada de datos.
# Es el almacen usado si el llamador no especifica otro (cabecera "Almacen" en /api/*, o el
# selector de la interfaz web). Lista completa de almacenes validos: src/lux/warehouses.ts
# (SAGUNTO, CHESTECM, ALMUSSAFES, MONTAVERNER, CHESTE).
LUX_WAREHOUSE=

# Timeout (ms) para las llamadas HTTP hacia LUX (login, refresh, /proc)
LUX_TIMEOUT_MS=10000

# Margen de seguridad (ms) antes de expiresAt para refrescar el token de forma proactiva
LUX_REFRESH_MARGIN_MS=60000

# TTL (ms) de la cache en memoria de catalogos (CatalogosService). No usar un valor "0" o vacio
# que implique cache indefinida.
LUX_CATALOG_CACHE_TTL_MS=300000

# --- Aplicacion ---
# Nivel de log: debug | info | warn | error
LOG_LEVEL=info

# Puerto HTTP del servidor Express propio de AZA
PORT=3000

# Entorno: development | test | staging | production
NODE_ENV=development

# --- Seguridad de la API propia de AZA ---
# Clave compartida obligatoria que deben enviar los consumidores internos de AZA (ERP, app movil,
# etc.) en la cabecera "X-Api-Key" para poder llamar a esta API (/api/*). /health/* sigue siendo
# publico para el orquestador/monitor. Genera un valor aleatorio largo (ej. `openssl rand -hex 32`)
# y distribuyelo solo a los sistemas internos autorizados. NUNCA commitees aqui un valor real.
AZA_API_KEY=

# --- Interfaz web de almacen (/almacen/*) ---
# Secreto usado por express-session para firmar la cookie de sesion del personal de almacen que
# usa las pantallas web (login/expediciones/recepciones). Es un sistema de autenticacion
# COMPLETAMENTE INDEPENDIENTE de AZA_API_KEY (esa protege /api/*, pensado para otros sistemas,
# no personas). Genera un valor aleatorio largo (ej. `openssl rand -hex 32`). NUNCA commitees
# aqui un valor real.
SESSION_SECRET=
