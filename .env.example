# Copiar a .env y rellenar con valores reales (NUNCA commitear .env)

# --- LUX API ---
# URL base de la API LUX (Whales), sin barra final. Ej: https://lux.whales-provider.example
LUX_BASE_URL=

# Credenciales del usuario tecnico de la API LUX (rol "web")
LUX_USERNAME=
LUX_PASSWORD=

# Codigo de almacen POR DEFECTO a enviar en la cabecera HTTP "Almacen" en cada llamada de datos.
# Es el almacen usado si el llamador no especifica otro (cabecera "Almacen" en /api/*, o el
# selector de la interfaz web). Lista completa de almacenes validos: src/lux/warehouses.ts
# (SAGUNTO, CHESTECM, ALMUSSAFES, MONTAVERNER, CHESTE).
LUX_WAREHOUSE=

# Timeout (ms) para las llamadas HTTP hacia LUX (login, refresh, /proc)
LUX_TIMEOUT_MS=10000

# Margen de seguridad (ms) antes de expiresAt para refrescar el token de forma proactiva
LUX_REFRESH_MARGIN_MS=60000

# TTL (ms) de la cache en memoria de catalogos (CatalogosService). No usar un valor "0" o vacio
# que implique cache indefinida.
LUX_CATALOG_CACHE_TTL_MS=300000

# --- Aplicacion ---
# Nivel de log: debug | info | warn | error
LOG_LEVEL=info

# Puerto HTTP del servidor Express propio de AZA
PORT=3000

# Entorno: development | test | staging | production
NODE_ENV=development

# --- Seguridad de la API propia de AZA ---
# Clave compartida obligatoria que deben enviar los consumidores internos de AZA (ERP, app movil,
# etc.) en la cabecera "X-Api-Key" para poder llamar a esta API (/api/*). /health/* sigue siendo
# publico para el orquestador/monitor. Genera un valor aleatorio largo (ej. `openssl rand -hex 32`)
# y distribuyelo solo a los sistemas internos autorizados. NUNCA commitees aqui un valor real.
AZA_API_KEY=

# --- Interfaz web de almacen (/almacen/*) ---
# Secreto usado por express-session para firmar la cookie de sesion del personal de almacen que
# usa las pantallas web (login/expediciones/recepciones). Es un sistema de autenticacion
# COMPLETAMENTE INDEPENDIENTE de AZA_API_KEY (esa protege /api/*, pensado para otros sistemas,
# no personas). Genera un valor aleatorio largo (ej. `openssl rand -hex 32`). NUNCA commitees
# aqui un valor real.
SESSION_SECRET=

# La cookie de sesion de la web va marcada como `secure` por defecto cuando NODE_ENV=production,
# y los navegadores NO la guardan por HTTP (el login no se mantendria). Si se accede por HTTP plano
# (p.ej. http://SRVNewWhales.zar.local:3000) pon false. Con HTTPS delante (recomendado), true.
# Por defecto: true si NODE_ENV=production, false en el resto.
SESSION_COOKIE_SECURE=false

# --- Watcher de logs LUX (npm run watch-logs, proceso independiente del servidor HTTP) ---
# Rutas a los ficheros de log activos de LUX (unidad de red). Ver docs/lux-api-analysis.md §16.
# Solo obligatorias para "npm run watch-logs"; el servidor principal ("npm run dev"/"npm start")
# no las necesita.
LUX_LOG_PATH=S:\TLSI\LUX\lux.log.0
LUX_MOBILE_LOG_PATH=S:\TLSI\LUX_mobile\lux.log.0

# Intervalo de sondeo de ambos logs, en ms (por defecto 1000).
WATCHER_POLL_MS=1000

# Ventana de espera (ms) tras la ultima linea detectada de un pedido antes de re-consultarlo,
# para agrupar varias lineas seguidas en una sola llamada (por defecto 2000). No bajar de ~1000:
# LUX escribe la linea al EMPEZAR el procedimiento, consultar antes podria leer el estado anterior.
WATCHER_DEBOUNCE_MS=2000

# Tope de espera (ms) del debounce desde la primera linea agrupada: con actividad continua del
# mismo pedido, se refresca igualmente a los 15 s (por defecto 15000).
WATCHER_MAX_WAIT_MS=15000

# Espera base (ms) entre reintentos de un refresco fallido por causa transitoria (LUX caido, red,
# token, sink). Crece x1, x2, x3... hasta 5 min. Mientras haya reintentos pendientes la posicion
# de los logs no se confirma, asi no se pierde ningun evento (por defecto 30000).
WATCHER_RETRY_MS=30000

# Carpeta donde el watcher guarda un JSON por evento detectado (cabecera + lineas + contenedores
# completos), solucion provisional para revisar los datos mientras se define el destino definitivo
# (base de datos u otro sistema). Por defecto "data/watcher-events" (ya esta en .gitignore).
WATCHER_JSON_DIR=data/watcher-events

# Carpeta aparte para los JSON del DECA de rutas (p_expRutasDeca): cada fichero lleva la consulta
# hecha a la API (procedimiento, accion, parametros, almacen) y los datos devueltos.
WATCHER_RUTAS_DECA_DIR=data/watcher-rutas-deca

# Carpeta donde se guarda la posicion leida de cada log (recuperacion tras corte/rotacion).
WATCHER_STATE_DIR=data/watcher-state

# --- Docuten (eCMR) ---
# Clave de la API de Docuten (descarga de documentos de un envio: shipments/{id}/documents/download).
# NUNCA commitees aqui un valor real.
DOCUTEN_API_KEY=
# URL base de la API de Docuten. Los envios que crea LUX estan en PRODUCCION (DOCUTEN_URL de la
# configuracion de Whales): https://ecmr.docuten.com/api/v1. El sandbox (ecmr-sandbox.docuten.com)
# no conoce esos envios y rechaza la clave de produccion.
DOCUTEN_BASE_URL=https://ecmr.docuten.com/api/v1
